{{- define "committee_status_updates" -}}
{{- $members        := .Members }}
{{- $histories        := .Histories }}

<fieldset>
    <legend>Member satus changes</legend>
    {{ if $histories }}
      <table>
        <thead>
          <tr>
            <th>Login</th>
            <th>New Status</th>
          </tr>
        </thead>
        <tbody>
          {{ range $members }}
          {{- $nickname := .Nickname }}
          {{- $status := index $histories .Nickname }}
          <tr>
            <td>{{ $nickname }}</td>
            <td>{{ $status.Label }}</td>
          </tr>
        {{ end }}
        </tbody>
      </table>
    {{ else }}
      <i>No changes</i>
    {{ end }}
  </fieldset>
{{- end -}}
