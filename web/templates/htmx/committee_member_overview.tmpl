{{ template "header" . }}
{{- $sessionID           := .Session.ID }}
{{- $committeeMembers    := .Members }}
{{- $committee           := .Committee }}
<fieldset>
<legend>Members of committee <strong>{{ $committee.Name }}</strong></legend>
<table>
    <thead>
    <tr>
        <th>Login</th>
        <th>Firstname</th>
        <th>Lastname</th>
        <th>Status</th>
    </tr>
    </thead>
    <tbody>
    {{ range $committeeMembers }}
        {{- $ms := .MembershipByID $committee.ID }}
        <tr>
        <td>{{ .Nickname }}</td>
        <td>{{ .Firstname }}</td>
        <td>{{ .Lastname }}</td>
        <td id="editable-status-{{ .Nickname }}">
            {{ template "member_status_display" Args "CommitteeID" $committee.ID "Status" $ms.Status "Nickname" .Nickname }}
        </td>
        </tr>
    {{ end }}
    </tbody>
</table>
</fieldset>
{{ template "footer" }}
